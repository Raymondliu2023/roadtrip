# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
POSTGRES_URL=postgresql://user:password@localhost:5432/roadtrip
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=roadtrip_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=roadtrip

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# External API Keys
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
MAPBOX_API_KEY=your_mapbox_api_key_here

# Car Rental Provider API Keys (if using real providers)
ENTERPRISE_API_KEY=your_enterprise_api_key_here
HERTZ_API_KEY=your_hertz_api_key_here
AVIS_API_KEY=your_avis_api_key_here

# Timeouts (milliseconds)
PROVIDER_TIMEOUT=5000
TOTAL_REQUEST_TIMEOUT=10000

# Caching TTL (seconds)
ROUTE_CACHE_TTL=86400
RATE_CACHE_TTL=3600

# Feature Flags
USE_MOCK_PROVIDERS=true
ENABLE_METRICS=true
ENABLE_TRACING=false
